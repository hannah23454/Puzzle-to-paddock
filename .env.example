# Copy to .env.local and fill in. Never commit real values.

# Airtable (fallback delivery for /register, and /contact)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_REGISTER_TABLE=
AIRTABLE_CONTACT_TABLE=

# Make.com intake webhook for /register. When set, registrations are POSTed here instead of Airtable.
MAKE_INTAKE_WEBHOOK_URL=
